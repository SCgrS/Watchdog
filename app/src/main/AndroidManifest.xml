<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Only two permissions: Showing notifications and checking when the phone starts. No settings writing, internet,
        accessibility, device admin or exact alarm permission. The list is checked on every build (app/build.gradle.kts,
        ManifestCheck). If it differs, no package is built.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
        Package visibility, not permissions. The package entry shows whether Samsung's Auto Blocker exists on this phone.
        The intent entry shows the apps with an icon in the app list, so the app can see which of them are allowed to
        install unknown apps (SettingsReader). Nothing about them is stored or leaves the phone.
    -->
    <queries>
        <package android:name="com.samsung.android.rampart" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/backup_rules"
        android:hasFragileUserData="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:taskAffinity=""
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Opens a settings page from a notification action and closes right away. Only the app itself can open it. -->
        <activity
            android:name=".SettingsOpenerActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay" />

        <!-- Scheduled check. Only the app's own alarm reaches it. -->
        <receiver
            android:name=".CheckReceiver"
            android:exported="false" />

        <!-- Phone start, app update and clock change. Only the system can send these broadcasts. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>

        <!-- Job the system runs when a watched setting changes. Only the system can bind to it. -->
        <service
            android:name=".SettingChangeJob"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>
</manifest>
