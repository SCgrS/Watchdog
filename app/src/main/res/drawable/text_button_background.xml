<?xml version="1.0" encoding="utf-8"?>
<!-- Quiet text button (Cancel in the choice window): No border, only a rounded ripple on touch. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#1FFFFFFF">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</ripple>
