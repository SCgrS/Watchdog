<?xml version="1.0" encoding="utf-8"?>
<!-- Choice row: The chosen option sits on a slightly raised surface, every row ripples on touch. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="?android:attr/colorControlHighlight">
    <item>
        <selector>
            <item android:state_selected="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/choice_selected" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#00000000" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
