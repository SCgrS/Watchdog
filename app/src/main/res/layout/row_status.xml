<?xml version="1.0" encoding="utf-8"?>
<!--
    A setting's tile in the status card: The icon on a colored square, the name with the line under it (where the setting
    lives, the apps it is allowed for, or Auto Blocker's note), the value and a chevron. The tile's tint and colors come
    from what the state means (MainActivity.showStatusRow). A tap opens the setting.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="Overdraw"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:background="@drawable/tile_background"
    android:clickable="true"
    android:focusable="true"
    android:foreground="@drawable/tile_ripple"
    android:gravity="center_vertical"
    android:minHeight="68dp"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="12dp"
    android:paddingEnd="8dp"
    android:paddingBottom="12dp">

    <FrameLayout
        android:id="@+id/badge"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/badge_background">

        <ImageView
            android:id="@+id/icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/name"
            style="@style/RowTitle"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/location"
            style="@style/RowSubtitle" />
    </LinearLayout>

    <TextView
        android:id="@+id/value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:fontFamily="sans-serif-medium"
        android:textSize="15sp" />

    <ImageView
        style="@style/Chevron"
        android:layout_marginStart="4dp"
        android:importantForAccessibility="no" />
</LinearLayout>
