<?xml version="1.0" encoding="utf-8"?>
<!--
    The single screen, from top to bottom: Logo and name, warnings, the status card (summary, one tile per setting, the
    Check button), Settings (check interval, language, theme) and About.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:filterTouchesWhenObscured="true"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="24dp"
        android:paddingEnd="16dp"
        android:paddingBottom="32dp">

        <!-- The logo and the app's name. -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:accessibilityHeading="true"
            android:drawableStart="@drawable/ic_logo"
            android:drawablePadding="12dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical"
            android:text="@string/app_name"
            android:textColor="@color/text"
            android:textSize="26sp" />

        <!-- Warning: Notifications are off. -->
        <LinearLayout
            android:id="@+id/notification_warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/warning_background"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/notifications_off"
                android:textColor="@color/text"
                android:textSize="15sp" />

            <Button
                android:id="@+id/notification_button"
                style="@style/ButtonSecondary"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:text="@string/allow_notifications" />
        </LinearLayout>

        <!-- Warning: Background restricted, or the app can be paused. -->
        <LinearLayout
            android:id="@+id/background_warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/warning_background"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/background_warning_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text"
                android:textSize="15sp" />

            <Button
                android:id="@+id/background_button"
                style="@style/ButtonSecondary"
                android:layout_height="48dp"
                android:layout_marginTop="16dp" />
        </LinearLayout>

        <!--
            Status card: The main element of the screen. On top a summary in the color of what it says, below one tinted
            tile per setting (added in code) and the Check button.
        -->
        <LinearLayout
            android:id="@+id/hero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/hero_background"
            android:orientation="vertical"
            android:padding="6dp">

            <LinearLayout
                android:id="@+id/summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="14dp">

                <FrameLayout
                    android:id="@+id/summary_badge"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/badge_background">

                    <ImageView
                        android:id="@+id/summary_icon"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/summary_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:accessibilityHeading="true"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/text"
                        android:textSize="22sp" />

                    <TextView
                        android:id="@+id/last_check"
                        style="@style/RowSubtitle"
                        android:fontFeatureSettings="tnum" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/status_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Manual check: The settings are read right away, the result is told in a short message. -->
            <Button
                android:id="@+id/check_button"
                style="@style/ButtonBrand"
                android:layout_marginTop="8dp"
                android:text="@string/check" />
        </LinearLayout>

        <!-- Settings: Check interval (with the next check under it), language and theme. -->
        <TextView
            style="@style/SectionTitle"
            android:accessibilityHeading="true"
            android:text="@string/settings_title" />

        <LinearLayout style="@style/Card">

            <LinearLayout
                android:id="@+id/interval_row"
                style="@style/SettingRow">

                <ImageView
                    style="@style/SettingIcon"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_schedule" />

                <!-- The value sits on the name's line, so the next check under them has the whole width. -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/RowTitle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/check_interval" />

                        <TextView
                            android:id="@+id/interval_value"
                            style="@style/SettingValue" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/next_check"
                        style="@style/RowSubtitle"
                        android:fontFeatureSettings="tnum" />
                </LinearLayout>

                <ImageView
                    style="@style/Chevron"
                    android:importantForAccessibility="no" />
            </LinearLayout>

            <View style="@style/Divider" />

            <LinearLayout
                android:id="@+id/language_row"
                style="@style/SettingRow">

                <ImageView
                    style="@style/SettingIcon"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_language" />

                <TextView
                    style="@style/RowTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/language" />

                <TextView
                    android:id="@+id/language_value"
                    style="@style/SettingValue" />

                <ImageView
                    style="@style/Chevron"
                    android:importantForAccessibility="no" />
            </LinearLayout>

            <View style="@style/Divider" />

            <LinearLayout
                android:id="@+id/theme_row"
                style="@style/SettingRow">

                <ImageView
                    style="@style/SettingIcon"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_theme" />

                <TextView
                    style="@style/RowTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/theme" />

                <TextView
                    android:id="@+id/theme_value"
                    style="@style/SettingValue" />

                <ImageView
                    style="@style/Chevron"
                    android:importantForAccessibility="no" />
            </LinearLayout>
        </LinearLayout>

        <!-- About: What the app is and is not, the version and the developer's link. -->
        <TextView
            style="@style/SectionTitle"
            android:accessibilityHeading="true"
            android:text="@string/about_title" />

        <LinearLayout style="@style/Card">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="3sp"
                android:paddingStart="20dp"
                android:paddingTop="18dp"
                android:paddingEnd="20dp"
                android:paddingBottom="16dp"
                android:text="@string/about_text"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <View
                style="@style/Divider"
                android:layout_marginStart="20dp" />

            <TextView
                android:id="@+id/version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="20dp"
                android:paddingTop="14dp"
                android:paddingEnd="20dp"
                android:paddingBottom="14dp"
                android:textColor="@color/text"
                android:textSize="15sp" />

            <View
                style="@style/Divider"
                android:layout_marginStart="20dp" />

            <TextView
                android:id="@+id/developer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="20dp"
                android:paddingTop="14dp"
                android:paddingEnd="20dp"
                android:paddingBottom="14dp"
                android:textColor="@color/text"
                android:textColorLink="@color/link"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
