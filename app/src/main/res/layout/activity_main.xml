<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:filterTouchesWhenObscured="true"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/app_name"
            android:textColor="@color/text"
            android:textSize="28sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="4dp"
            android:text="@string/tagline"
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />

        <!-- Warning: Notifications are off. -->
        <LinearLayout
            android:id="@+id/notification_warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/warning_background"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/notifications_off"
                android:textColor="@color/text"
                android:textSize="15sp" />

            <Button
                android:id="@+id/notification_button"
                style="@style/ButtonSecondary"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:text="@string/allow_notifications" />
        </LinearLayout>

        <!-- Warning: Background restricted, or the app can be paused. -->
        <LinearLayout
            android:id="@+id/background_warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/warning_background"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/background_warning_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text"
                android:textSize="15sp" />

            <Button
                android:id="@+id/background_button"
                style="@style/ButtonSecondary"
                android:layout_height="48dp"
                android:layout_marginTop="16dp" />
        </LinearLayout>

        <!-- Status: The time of the last check on the right of the title. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="8dp"
            android:baselineAligned="true"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="@string/status_title"
                android:textColor="@color/text_muted"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/last_check"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:textColor="@color/text_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Status card: The one bright element of the screen, color only in the lamps. Rows are added in code. -->
        <LinearLayout style="@style/Card">

            <LinearLayout
                android:id="@+id/status_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/auto_blocker_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="16dp"
                android:text="@string/auto_blocker_unknown_note"
                android:textColor="@color/text_muted"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Manual check: The settings are read right away, the result is told in a short message. -->
        <Button
            android:id="@+id/check_button"
            style="@style/ButtonSecondary"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:text="@string/check" />

        <!-- Checks -->
        <TextView
            style="@style/SectionTitle"
            android:text="@string/checks_title" />

        <LinearLayout style="@style/Card">

            <LinearLayout
                android:id="@+id/interval_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="68dp"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingTop="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/RowTitle"
                        android:text="@string/check_interval" />

                    <TextView
                        style="@style/RowSubtitle"
                        android:text="@string/check_interval_description" />
                </LinearLayout>

                <TextView
                    android:id="@+id/interval_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="8dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron" />
            </LinearLayout>

            <View style="@style/Divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="68dp"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="12dp"
                android:paddingEnd="20dp"
                android:paddingBottom="12dp">

                <TextView
                    style="@style/RowTitle"
                    android:text="@string/next_check" />

                <TextView
                    android:id="@+id/next_check"
                    style="@style/RowSubtitle"
                    android:fontFeatureSettings="tnum" />
            </LinearLayout>
        </LinearLayout>

        <!-- App -->
        <TextView
            style="@style/SectionTitle"
            android:text="@string/app_title" />

        <LinearLayout style="@style/Card">

            <LinearLayout
                android:id="@+id/language_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="68dp"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingTop="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/RowTitle"
                        android:text="@string/language" />

                    <TextView
                        style="@style/RowSubtitle"
                        android:text="@string/language_description" />
                </LinearLayout>

                <TextView
                    android:id="@+id/language_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="8dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="@string/assurance"
            android:textColor="@color/text_muted"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
