<?xml version="1.0" encoding="utf-8"?>
<!-- An option in the choice window: A ring that fills green when chosen, and the option's name. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/choice_row_background"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">

    <View
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:background="@drawable/choice_indicator"
        android:duplicateParentState="true"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/choice_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:duplicateParentState="true"
        android:textColor="@color/text"
        android:textSize="16sp" />
</LinearLayout>
